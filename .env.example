# Credenciales R2 usadas por el agente `medios` para subir imágenes
# optimizadas. Copiar a `.env` (gitignoreado) y completar con los
# valores reales del bucket.

# ID de cuenta de Cloudflare (para el endpoint S3-compatible de R2)
R2_ACCOUNT_ID=

# API token de R2 con permiso de escritura sobre el bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombre del bucket R2 donde se guardan las imágenes de los blogs
R2_BUCKET_NAME=

# URL pública desde donde se sirven las imágenes (dominio custom
# conectado al bucket)
R2_PUBLIC_URL=https://blog-media.ladetec.com
